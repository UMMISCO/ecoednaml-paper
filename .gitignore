# =============================================================================
# .gitignore for eDNA-analysis-code
# =============================================================================

# Generated analysis outputs (fully regenerable by pipeline scripts)
analyses/**/*.Rda
analyses/**/*.rda
analyses/**/*.csv
analyses/**/*.tsv
analyses/**/*.pdf
analyses/**/*.txt

# Stray R plot output at repo root
Rplots.pdf
# Ignore all files in /data except README.md and presence_absence matrix
data/*
!data/README.md
!data/smX_pres_abs_matrix.rda

# Ignore all hidden files and directories at root
/.*

# R session artefacts
.RData
.Rhistory
*.Rout

# ggspatial / rosm tile cache
rosm.cache/

# macOS
.DS_Store

# Editor backup files
*~
*.swp

# Allow gitignore itself
!.gitignore

# Excude the script for data preprocessing
analyses/scripts/clean_input_csv.R
analyses/scripts/make_db_object.R
analyses/scripts/make_db_object_clean.R
analyses/scripts/extract_highlighted_taxa.R

# Exclude graphics output from predomics
graphics_from_terBeam*
Rplots.pdf

# Exclude species images used for figure annotation
analyses/figures/Figure6/species_images/